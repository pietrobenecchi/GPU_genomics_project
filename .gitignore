build/
**/build/
build-gpu/
**/build-gpu/
.DS_Store
**/.DS_Store

# Vendored third-party benchmark suite (~2.7 GB): the GGBS checkout and the
# Zenodo archives. Not our code and too large to track. Fetch with:
#   git clone https://github.com/Mirkocoggi/GGBS external_datasets/GGBS
#   zenodo archives: https://zenodo.org/records/12207360
# The derived validation inputs we actually depend on live in
# theseus_gpu/data/validation/ggbs and are tracked.
external_datasets/

# Per-run GPU output from run_ggbs_gpu_regression.py. The frozen CPU references
# under golden/ are tracked; these are just the outputs being compared to them.
theseus_gpu/data/validation/ggbs/gpu_results/

# Ad-hoc run output. data/ holds inputs only; the expected sample output is
# baseline/sample_output.gaf, which is tracked.
theseus_gpu/data/sample_output.gaf
theseus_gpu/validation_runs/

__pycache__/
**/__pycache__/
*.pyc

# Profiling output: the raw Nsight dumps (161 MB of .ncu-rep/.nsys-rep) and the
# campaign notes written alongside them, plus whatever scripts/run_all.sh
# produces. All kept on disk, none of it project source.
profile-cuda/
profiling/
theseus_gpu/theseus-proxy-colab.zip
